# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Replicate Configuration
REPLICATE_API_TOKEN=your_replicate_api_token

# Video generation provider: runway (default) or pornworks
VIDEO_PROVIDER=runway

# Runway Configuration (VIDEO_PROVIDER=runway)
RUNWAY_API_KEY=your_runway_api_key

# PornWorks Configuration (VIDEO_PROVIDER=pornworks)
# Key and base URL come from https://pornworks.com/en/api/projects
PORNWORKS_API_KEY=your_pornworks_api_key
PORNWORKS_API_BASE=https://api.pornworks.example/v1
# Only if the docs put the key in a different header, e.g. X-API-Key with no prefix
# PORNWORKS_AUTH_HEADER=Authorization
# PORNWORKS_AUTH_PREFIX=Bearer

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# CORS Configuration
FRONTEND_URL=https://eromify.com

# Rate Limiting - Optimized for high-traffic SaaS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

